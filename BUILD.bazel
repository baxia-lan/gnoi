"""
gNOI proto definitions — BUILD.bazel added on claude branch.

Migration status: Phase 1 Bazel migration.
Build type: Protocol Buffers → generated Go/Python/C++ stubs
"""

load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_go//proto:compiler.bzl", "go_proto_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_protos",
    srcs = glob(["**/*.proto"]),
)

proto_library(
    name = "gnoi_proto",
    srcs = [":all_protos"],
    visibility = ["//visibility:public"],
)

go_proto_library(
    name = "gnoi_go_proto",
    importpath = "github.com/openconfig/gnoi",
    proto = ":gnoi_proto",
    visibility = ["//visibility:public"],
)

